      "namedRegex": "^/account/forgot\\-password(?:/)?$"
    },
    {
      "page": "/account/login",
      "regex": "^/account/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/account/login(?:/)?$"
    },
    {
      "page": "/account/orders",
      "regex": "^/account/orders(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/account/orders(?:/)?$"
    },
    {
      "page": "/account/register",
      "regex": "^/account/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/account/register(?:/)?$"
    },
    {
      "page": "/account/reset-password",
      "regex": "^/account/reset\\-password(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/account/reset\\-password(?:/)?$"
    },
    {
      "page": "/cart",
      "regex": "^/cart(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/cart(?:/)?$"
    },
    {
      "page": "/checkout",
      "regex": "^/checkout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/checkout(?:/)?$"
    },
    {
      "page": "/checkout/success",
      "regex": "^/checkout/success(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/checkout/success(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/search",
      "regex": "^/search(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/search(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/wishlist",
      "regex": "^/wishlist(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/wishlist(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": true,
    "dynamicRSCPrerender": true
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "ppr": {
    "chain": {
      "headers": {
        "next-resume": "1"
      }
    }
  }
}