# Public URL of the Laravel API (used by the browser and for image URLs).
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL the Next.js server uses to reach the API (can be an internal address in production).
API_URL=http://localhost:8000

# Canonical public URL of this storefront (sitemap, canonical links, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret shared with the Laravel backend for on-demand cache revalidation.
REVALIDATION_SECRET=

# Mailchimp newsletter integration.
# API key from https://us1.admin.mailchimp.com/account/api/ (format: xxxxxxxx-usXX)
MAILCHIMP_API_KEY=
# Audience (list) ID from Mailchimp → Audience → Settings → Audience name and defaults
MAILCHIMP_AUDIENCE_ID=
